{
  "name": "zcode-tokenspeed",
  "version": "1.0.0",
  "mcpServers": {
    "zcode-toolkit": {
      "type": "stdio",
      "command": "node",
      "args": ["${ZCODE_PLUGIN_ROOT}/dist/server.mjs"],
      "env": {
        "ZTK_POLL_SEC": "${user_config.poll_sec}",
        "ZTK_POLISH_KEY": "${user_config.polish_key}",
        "ZTK_POLISH_BASE_URL": "${user_config.polish_base_url}"
      }
    }
  },
  "ui": {
    "surfaces": [
      {
        "id": "tps",
        "title": {
          "zh-CN": "TPS 监控",
          "en-US": "TPS Monitor"
        },
        "icon": "activity",
        "server": "zcode-toolkit",
        "resourceUri": "ui://zcode-tokenspeed/dashboard.html",
        "availability": "session"
      }
    ]
  },
  "userConfig": {
    "poll_sec": {
      "type": "string",
      "title": "TPS 轮询周期(秒)",
      "default": "2"
    },
    "polish_key": {
      "type": "string",
      "title": "润色 API Key 覆盖（留空=用 provider_config）",
      "default": ""
    },
    "polish_base_url": {
      "type": "string",
      "title": "润色 Base URL 覆盖（留空=用 provider_config）",
      "default": ""
    }
  },
  "hooks": "hooks",
  "commands": "commands"
}
